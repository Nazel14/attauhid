# Laravel default
/node_modules
public/hot
public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# === CATATAN DEPLOY ===
# /public/build SENGAJA TIDAK di-ignore.
# Hostinger tidak menjalankan `npm run build`, jadi hasil Vite
# harus ikut ter-commit setiap kali ada perubahan JSX/JS.

# Skip file storage upload (audio & pdf setoran) — isinya saja,
# foldernya tetap dibawa lewat .gitkeep supaya ada di server.
/storage/app/public/audio_setorans/*
!/storage/app/public/audio_setorans/.gitkeep
/storage/app/public/pdf_setorans/*
!/storage/app/public/pdf_setorans/.gitkeep
/storage/app/public/profile-photos/*
!/storage/app/public/profile-photos/.gitkeep
/public/storage/audio_setorans
/public/storage/pdf_setorans

# Cache & log — isinya di-skip, .gitkeep dipertahankan supaya
# struktur foldernya tetap terbentuk di server.
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# Skip backup files
*.sql
*.zip
*.tar.gz

# Skip DS_Store/Thumbs
.DS_Store
Thumbs.db