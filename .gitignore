# Laravel default
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# === TAMBAHAN PENTING ===
# Skip file storage upload (audio & pdf setoran)
/storage/app/public/audio_setorans
/storage/app/public/pdf_setorans
/public/storage/audio_setorans
/public/storage/pdf_setorans

# Cache & log yang tidak boleh ke-commit
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*

# Skip backup files
*.sql
*.zip
*.tar.gz

# Skip DS_Store/Thumbs
.DS_Store
Thumbs.db